# Managed by dev - 由管理器生成
[mysqld]
port = 3307
bind-address = 127.0.0.1
datadir = /Users/xman/DevEnvironment/data/mysql/8.0/data
socket = /Users/xman/DevEnvironment/run/mysql/mysql80.sock
pid-file = /Users/xman/DevEnvironment/run/mysql/mysql80.pid
log-error = /Users/xman/DevEnvironment/logs/mysql/8.0/error.log
secure_file_priv = /Users/xman/DevEnvironment/data/mysql/8.0/files
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '+08:00'
max_connections = 200
max_allowed_packet = 64M
innodb_buffer_pool_size = 256M
innodb_flush_log_at_trx_commit = 2
slow_query_log = 1
slow_query_log_file = /Users/xman/DevEnvironment/logs/mysql/8.0/slow.log
long_query_time = 2
log_bin_trust_function_creators = 1

[client]
port = 3307
socket = /Users/xman/DevEnvironment/run/mysql/mysql80.sock
default-character-set = utf8mb4
